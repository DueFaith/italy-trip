---
const { title } = Astro.props as { title?: string };
---
<header class="px-4 py-3 border-b border-border bg-bg/80 backdrop-blur sticky top-0 z-10 flex items-center justify-between">
  <a href="/" class="text-sm font-semibold tracking-tight">{title ?? 'Dolomites'}</a>
  <a href="/customize" class="text-xs text-ink-muted">Customize</a>
</header>
