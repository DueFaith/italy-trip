---
/* Custom 1.5px-stroke vintage map glyphs — no Lucide / Heroicons. */
const items = [
  { href: '/',       label: 'Home',  icon: 'home' },
  { href: '/day',    label: 'Day',   icon: 'day' },
  { href: '/map',    label: 'Map',   icon: 'map' },
  { href: '/hikes',  label: 'Hikes', icon: 'hikes' },
  { href: '/more',   label: 'More',  icon: 'more' },
] as const;
const path = Astro.url.pathname;
const activeIndex = Math.max(
  0,
  items.findIndex((it) => (it.href === '/' ? path === '/' : path === it.href || path.startsWith(it.href + '/')))
);
---
<nav
  aria-label="Primary"
  class="fixed left-0 right-0 z-30"
  style="
    bottom: 0;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-top: 1px solid var(--hairline);
    padding-bottom: env(safe-area-inset-bottom);
  "
>
  <div
    class="relative grid"
    style="grid-template-columns: repeat(5, 1fr); height: 64px;"
  >
    {/* Sliding gold underline — width = 20% (one of five tabs) */}
    <span
      aria-hidden="true"
      style={`
        position: absolute;
        top: 0;
        height: 2px;
        width: 20%;
        background: var(--gold);
        transform: translateX(${activeIndex * 100}%);
        transition: transform 320ms cubic-bezier(0.2, 0.7, 0.1, 1);
      `}
    ></span>

    {items.map((it, i) => {
      const active = i === activeIndex;
      const stroke = active ? 'var(--ink)' : 'var(--ink-soft)';
      const labelColor = active ? 'var(--ink)' : 'var(--ink-soft)';
      return (
        <a
          href={it.href}
          aria-current={active ? 'page' : undefined}
          class="flex flex-col items-center justify-center"
          style={`gap: 4px; min-height: 56px; padding: 6px 4px; color: ${labelColor};`}
        >
          {it.icon === 'home' && (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 20 L9 9 L13 15 L16 11 L21 20 Z" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" />
              {active && <circle cx="9" cy="9" r="1.1" fill="var(--gold)" />}
            </svg>
          )}
          {it.icon === 'day' && (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="3.4" stroke={stroke} stroke-width="1.5" fill="none" />
              <path d="M12 4 V6 M12 18 V20 M4 12 H6 M18 12 H20 M6.3 6.3 L7.7 7.7 M16.3 16.3 L17.7 17.7 M6.3 17.7 L7.7 16.3 M16.3 7.7 L17.7 6.3"
                stroke={stroke} stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
          {it.icon === 'map' && (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 6 L9 4 L15 6 L21 4 V18 L15 20 L9 18 L3 20 Z" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" />
              <path d="M9 4 V18 M15 6 V20" stroke={stroke} stroke-width="1.25" stroke-dasharray="1.5 2.5" />
            </svg>
          )}
          {it.icon === 'hikes' && (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M2 19 L8 9 L12 14 L15 10 L22 19" stroke={stroke} stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" />
              <path d="M3 21 H21" stroke={stroke} stroke-width="1.25" stroke-dasharray="2 3" />
              {active && <circle cx="8" cy="9" r="1" fill="var(--gold)" />}
            </svg>
          )}
          {it.icon === 'more' && (
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="6" cy="12" r="1.4" stroke={stroke} stroke-width="1.5" fill="none" />
              <circle cx="12" cy="12" r="1.4" stroke={stroke} stroke-width="1.5" fill="none" />
              <circle cx="18" cy="12" r="1.4" stroke={stroke} stroke-width="1.5" fill="none" />
            </svg>
          )}
          <span
            class="font-mono"
            style={`font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; ${active ? 'font-weight: 700;' : ''}`}
          >{it.label}</span>
        </a>
      );
    })}
  </div>
</nav>
