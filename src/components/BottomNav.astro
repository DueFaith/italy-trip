---
const items = [
  { href: '/', label: 'Home' },
  { href: '/day', label: 'Day' },
  { href: '/map', label: 'Map' },
  { href: '/hikes', label: 'Hikes' },
  { href: '/more', label: 'More' },
];
const path = Astro.url.pathname;
---
<nav class="fixed bottom-0 left-0 right-0 h-16 bg-forest text-white/85 flex justify-around items-center text-xs border-t border-forest z-20">
  {items.map((it) => (
    <a href={it.href} class:list={[
      'flex flex-col items-center gap-0.5 py-2 px-3',
      path === it.href || path.startsWith(it.href + '/') ? 'text-white font-semibold' : ''
    ]}>{it.label}</a>
  ))}
</nav>
