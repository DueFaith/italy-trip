---
/*
 * Hike detail — vintage poster aesthetic.
 *
 * Two-part structure:
 *   PART I  — the route itself (stats, trailhead, parking, highlights, food, hazards)
 *   PART II — THE DAY (this hike's day in full: schedule, driving, lodging,
 *             "also today" cross-links to other hikes scheduled the same day)
 *
 * That way, opening any hike gives you the complete operational picture for
 * that day — you never have to hop back and forth between hike and day pages.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditHikeButton from '@/components/customize/EditHikeButton';
import WeatherWidget from '@/components/WeatherWidget';
import { getHikes, getDays, getHike, getLodgings } from '@/lib/content';

export async function getStaticPaths() {
  const hikes = await getHikes();
  return hikes.map((h) => ({ params: { slug: h.slug }, props: { hike: h } }));
}

const { hike } = Astro.props;
const days = await getDays();
const dayForHike = days.find((d) => d.data.hikeSlugs.includes(hike.slug));
const dayIndex = dayForHike ? days.findIndex((d) => d.data.date === dayForHike.data.date) : -1;
const totalDays = days.length;

// Lodging for this hike's day
const lodgings = await getLodgings();
const dayLodging = dayForHike ? lodgings.find((l) => l.id === dayForHike.data.lodgingSlug) : null;

// Other hikes scheduled the same day as this one
const otherHikeRefs = dayForHike
  ? dayForHike.data.hikeSlugs.filter((slug: string) => slug !== hike.slug)
  : [];
const otherHikes = await Promise.all(otherHikeRefs.map((slug: string) => getHike(slug)));

const fmtDate = (iso: string) => new Date(iso + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
const fmtFull = (iso: string) => new Date(iso + 'T00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

// Star rating
const stars = hike.data.rating?.stars ?? null;
const fullStars = stars ? Math.floor(stars) : 0;
const halfStar = stars ? (stars - fullStars >= 0.5 ? 1 : 0) : 0;
---
<BaseLayout title={hike.data.name} activeDayDate={dayForHike?.data.date}>

  {/* ════════ PART I — THE ROUTE ════════ */}

  {/* Hero */}
  <section class="stagger" style="padding: 24px var(--page-x) 12px;">
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      {dayForHike && (
        <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft); font-weight: 700;">
          Day {String(dayIndex + 1).padStart(2, '0')} / {String(totalDays).padStart(2, '0')}
        </span>
      )}
      <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">·</span>
      <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">{hike.data.region}</span>
      <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">·</span>
      <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">{hike.data.type.replace('-', ' ')}</span>
    </div>
    <h1 style="
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 800;
      font-variation-settings: 'opsz' 144;
      font-size: clamp(36px, 9vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 12px 0 14px;
    ">{hike.data.name}</h1>

    {stars && (
      <div style="display: flex; align-items: center; gap: 8px;">
        <div style="display: flex; gap: 2px;" aria-label={`${stars} out of 5`}>
          {Array.from({ length: 5 }, (_, i) => {
            const filled = i < fullStars;
            const half = i === fullStars && halfStar === 1;
            return (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <defs>{half && (<linearGradient id={`half-${hike.slug}-${i}`} x1="0" y1="0" x2="1" y2="0">
                  <stop offset="50%" stop-color="var(--gold)" />
                  <stop offset="50%" stop-color="transparent" />
                </linearGradient>)}</defs>
                <path d="M12 2 L14.6 8.6 L21.6 9.2 L16.3 13.9 L17.9 20.8 L12 17.2 L6.1 20.8 L7.7 13.9 L2.4 9.2 L9.4 8.6 Z"
                  fill={filled ? 'var(--gold)' : (half ? `url(#half-${hike.slug}-${i})` : 'transparent')}
                  stroke="var(--gold)"
                  stroke-width="1.2"
                  stroke-linejoin="round" />
              </svg>
            );
          })}
        </div>
        <span class="mono tabular" style="font-size: 12px; color: var(--ink-soft); letter-spacing: 0.04em;">{stars.toFixed(1)} <span style="opacity: 0.7;">({hike.data.rating?.reviews?.toLocaleString() ?? 0})</span></span>
      </div>
    )}

    <div style="margin-top: 12px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
      <EditHikeButton canonical={{ ...hike.data, slug: hike.slug }} client:load />
      {hike.data.alltrailsUrl && (
        <a href={hike.data.alltrailsUrl} style="
          font-family: var(--font-mono);
          font-size: 11px;
          letter-spacing: 0.16em;
          text-transform: uppercase;
          color: var(--ink-soft);
          padding: 8px 12px;
          border: 1px solid var(--gold);
          border-radius: var(--r-sm);
        ">View on AllTrails →</a>
      )}
    </div>
  </section>

  {/* 2x2 stat block */}
  <section class="stagger" style="padding: 14px var(--page-x);">
    <div style="
      background: var(--bg-paper);
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      padding: 18px 4px;
      box-shadow: var(--shadow-paper-md);
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
    ">
      <div style="text-align: center; padding: 8px 4px; border-right: 1px dashed var(--hairline); border-bottom: 1px dashed var(--hairline);">
        <div class="mono tabular" style="font-family: var(--font-display); font-weight: 800; font-variation-settings: 'opsz' 80; font-size: 36px; color: var(--ink); line-height: 1;">{hike.data.distanceKm}</div>
        <div class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-top: 6px;">Distance · km</div>
      </div>
      <div style="text-align: center; padding: 8px 4px; border-bottom: 1px dashed var(--hairline);">
        <div class="mono tabular" style="font-family: var(--font-display); font-weight: 800; font-variation-settings: 'opsz' 80; font-size: 36px; color: var(--ink); line-height: 1;">{hike.data.elevationGainM}</div>
        <div class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-top: 6px;">Gain · metres</div>
      </div>
      <div style="text-align: center; padding: 8px 4px; border-right: 1px dashed var(--hairline);">
        <div class="mono tabular" style="font-family: var(--font-display); font-weight: 800; font-variation-settings: 'opsz' 80; font-size: 36px; color: var(--ink); line-height: 1;">{hike.data.movingTimeHours.min}–{hike.data.movingTimeHours.max}</div>
        <div class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-top: 6px;">Moving · hours</div>
      </div>
      <div style="text-align: center; padding: 8px 4px;">
        <div style="font-family: var(--font-display); font-weight: 800; font-variation-settings: 'opsz' 80; font-size: 28px; color: var(--ink); line-height: 1; text-transform: capitalize; letter-spacing: -0.01em;">{hike.data.difficulty}</div>
        <div class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-top: 6px;">Grade</div>
      </div>
    </div>
  </section>

  {/* Trailhead */}
  <section class="stagger" style="padding: 18px var(--page-x);">
    <h2 class="eyebrow" style="margin: 0 0 10px;">Trailhead</h2>
    <div style="background: var(--bg-paper); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: 14px 16px; box-shadow: var(--shadow-paper-sm);">
      <div style="display: flex; align-items: flex-start; gap: 12px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex: 0 0 auto; margin-top: 2px;">
          <path d="M2 19 L9 7 L13.5 14 L16 10 L22 19 Z" stroke="var(--gold)" stroke-width="1.5" stroke-linejoin="round" fill="none" />
          <circle cx="9" cy="7" r="0.9" fill="var(--gold)" />
        </svg>
        <div style="flex: 1;">
          <div style="font-family: var(--font-display); font-weight: 600; font-size: 17px; color: var(--ink); line-height: 1.15;">{hike.data.trailhead.name}</div>
          <a href={`https://www.google.com/maps?q=${hike.data.trailhead.lat},${hike.data.trailhead.lon}`} class="mono tabular" style="font-size: 11.5px; color: var(--ink-soft); margin-top: 4px; display: inline-block; border-bottom: 1px dashed var(--gold); padding-bottom: 1px; letter-spacing: 0.03em;">
            {hike.data.trailhead.lat}, {hike.data.trailhead.lon}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Parking */}
  <section class="stagger" style="padding: 18px var(--page-x);">
    <h2 class="eyebrow" style="margin: 0 0 10px;">Parking</h2>
    <div style="background: var(--bg-paper); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: 14px 16px; box-shadow: var(--shadow-paper-sm);">
      <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px;">
        <span style="font-family: var(--font-display); font-weight: 600; font-size: 16px; color: var(--ink);">{hike.data.parking.name}</span>
        {hike.data.parking.costEur > 0 && (
          <span class="mono tabular" style="font-size: 14px; font-weight: 700; color: var(--ink-soft);">€{hike.data.parking.costEur}</span>
        )}
      </div>
      {hike.data.parking.mustBook && (
        <div class="mono-cap" style="
          margin-top: 10px;
          padding: 8px 10px;
          font-size: 10px;
          color: var(--signal);
          background: rgba(168, 50, 50, 0.06);
          border: 1px dashed var(--signal);
          border-radius: var(--r-sm);
          display: inline-block;
        ">⚠ Booking required {hike.data.parking.bookingUrl && (<>· <a href={hike.data.parking.bookingUrl} style="border-bottom: 1px solid var(--signal); padding-bottom: 1px;">Reserve</a></>)}</div>
      )}
    </div>
  </section>

  {/* Route highlights */}
  {hike.data.routeHighlights.length > 0 && (
    <section class="stagger" style="padding: 18px var(--page-x);">
      <h2 class="eyebrow" style="margin: 0 0 12px;">Route Highlights</h2>
      <ol style="list-style: none; margin: 0; padding: 0; display: grid; gap: 12px;">
        {hike.data.routeHighlights.map((h: string, i: number) => (
          <li style="display: flex; gap: 12px; align-items: flex-start;">
            <span style="
              flex: 0 0 32px;
              width: 32px;
              height: 32px;
              border: 1.5px solid var(--gold);
              border-radius: 50%;
              display: flex;
              align-items: center;
              justify-content: center;
              font-family: var(--font-mono);
              font-size: 12px;
              font-weight: 700;
              color: var(--gold);
              background: var(--bg);
              transform: rotate(-2deg);
              box-shadow: var(--shadow-stamp);
              position: relative;
            ">
              <span style="position: absolute; inset: 2px; border: 0.5px dashed var(--gold); border-radius: 50%; opacity: 0.6;"></span>
              {String(i + 1).padStart(2, '0')}
            </span>
            <span style="font-size: 14.5px; line-height: 1.45; color: var(--ink); padding-top: 4px;">{h}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {/* Food on trail */}
  {hike.data.foodOnTrail.length > 0 && (
    <section class="stagger" style="padding: 18px var(--page-x);">
      <h2 class="eyebrow" style="margin: 0 0 12px;">Food on the Trail</h2>
      <ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 10px;">
        {hike.data.foodOnTrail.map((f: { name: string; notes: string }) => (
          <li style="display: flex; gap: 12px; align-items: flex-start; padding: 10px 12px; background: var(--bg-paper); border: 1px solid var(--hairline); border-radius: var(--r-md);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex: 0 0 auto; margin-top: 2px;">
              <path d="M3 11 L12 4 L21 11 V21 H3 Z" stroke="var(--gold)" stroke-width="1.4" stroke-linejoin="round" fill="none" />
              <path d="M10 21 V15 H14 V21" stroke="var(--ink-soft)" stroke-width="1.2" />
            </svg>
            <div style="flex: 1; min-width: 0;">
              <div style="font-family: var(--font-display); font-weight: 600; font-size: 15px; color: var(--ink);">{f.name}</div>
              <div style="font-size: 12.5px; color: var(--ink-soft); margin-top: 2px; line-height: 1.4;">{f.notes}</div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* Hazards */}
  {hike.data.hazards.length > 0 && (
    <section class="stagger" style="padding: 18px var(--page-x);">
      <h2 class="eyebrow signal" style="margin: 0 0 12px;">Hazards & Tips</h2>
      <div style="
        background: var(--bg-paper);
        border: 1.5px solid var(--signal);
        border-radius: var(--r-sm);
        padding: 12px 14px 12px 16px;
        box-shadow: var(--shadow-paper-sm);
        position: relative;
      ">
        <ul style="list-style: none; margin: 0; padding: 0; display: grid; gap: 8px;">
          {hike.data.hazards.map((h: string) => (
            <li style="display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; line-height: 1.45; color: var(--ink);">
              <span style="flex: 0 0 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); margin-top: 7px;"></span>
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Bad weather option (for the hike itself) */}
  {hike.data.badWeatherOption && (
    <section class="stagger" style="padding: 18px var(--page-x);">
      <h2 class="eyebrow signal" style="margin: 0 0 12px;">If The Weather Turns</h2>
      <div style="background: var(--bg-paper); border: 1px solid var(--hairline); border-radius: var(--r-sm); padding: 12px 14px; font-size: 13.5px; color: var(--ink);">{hike.data.badWeatherOption}</div>
    </section>
  )}

  {/* ════════ PART II — THE DAY ════════ */}
  {dayForHike && (
    <>
      {/* Chapter break */}
      <div style="
        margin: 36px var(--page-x) 0;
        position: relative;
        padding: 18px 0 6px;
      ">
        <div style="display: flex; align-items: center; gap: 12px;">
          <span style="flex: 1; height: 1px; background: var(--gold);"></span>
          <span style="flex: 1; height: 1px; background: var(--gold); transform: translateY(-3px);"></span>
        </div>
        <div style="text-align: center; margin-top: 14px;">
          <span class="mono-cap" style="font-size: 11px; color: var(--ink-soft); letter-spacing: 0.32em; font-weight: 700;">Part II · The Day</span>
          <h2 style="
            font-family: var(--font-display);
            font-style: italic;
            font-weight: 800;
            font-variation-settings: 'opsz' 100;
            font-size: clamp(28px, 7vw, 40px);
            line-height: 1;
            letter-spacing: -0.02em;
            color: var(--ink);
            margin: 14px 0 8px;
          ">{dayForHike.data.theme}</h2>
          <p class="mono-cap" style="font-size: 10.5px; color: var(--ink-soft); margin: 0;">
            {fmtFull(dayForHike.data.date)} · Day {dayIndex + 1} of {totalDays}
          </p>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; margin-top: 18px;">
          <span style="flex: 1; height: 1px; background: var(--gold); transform: translateY(3px);"></span>
          <span style="flex: 1; height: 1px; background: var(--gold);"></span>
        </div>
      </div>

      {/* Schedule timeline */}
      {dayForHike.data.schedule.length > 0 && (
        <section class="stagger" style="padding: 24px var(--page-x) 8px;">
          <h3 class="eyebrow" style="margin: 0 0 12px;">Schedule</h3>
          <ol style="list-style: none; margin: 0; padding: 0; display: grid; gap: 0;">
            {dayForHike.data.schedule.map((s: { time: string; action: string }) => (
              <li style="display: flex; gap: 14px; align-items: baseline; padding: 10px 0; border-bottom: 1px dashed var(--hairline);">
                <span class="mono tabular" style="
                  flex: 0 0 56px;
                  font-size: 13px;
                  color: var(--ink-soft);
                  letter-spacing: 0.04em;
                  font-weight: 700;
                ">{s.time}</span>
                <span style="font-size: 14.5px; line-height: 1.4; color: var(--ink); font-weight: 400;">{s.action}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      {/* Weather */}
      <section class="stagger" style="padding: 14px var(--page-x);">
        <h3 class="eyebrow" style="margin: 0 0 10px;">Weather</h3>
        <WeatherWidget lat={dayForHike.data.weatherFor.lat} lon={dayForHike.data.weatherFor.lon} label={dayForHike.data.weatherFor.label} date={dayForHike.data.date} client:visible />
      </section>

      {/* Driving */}
      {dayForHike.data.driving.distanceKm > 0 && (
        <section class="stagger" style="padding: 14px var(--page-x);">
          <h3 class="eyebrow" style="margin: 0 0 10px;">Driving</h3>
          <div style="
            background: var(--bg-paper);
            border: 1px solid var(--hairline);
            border-radius: var(--r-md);
            padding: 14px 16px;
            box-shadow: var(--shadow-paper-sm);
          ">
            <div style="display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;">
              <div class="mono tabular" style="font-size: 22px; font-weight: 700; color: var(--ink);">
                {dayForHike.data.driving.distanceKm}<span class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-left: 4px;">km</span>
              </div>
              <div style="flex: 1; min-width: 60px; display: flex; align-items: center; gap: 8px;">
                <span style="height: 1px; flex: 1; background: var(--ink-soft); opacity: 0.4;"></span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12 H19 M14 6 L20 12 L14 18" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span style="height: 1px; flex: 1; background: var(--ink-soft); opacity: 0.4;"></span>
              </div>
              <div class="mono tabular" style="font-size: 22px; font-weight: 700; color: var(--ink);">
                {Math.floor(dayForHike.data.driving.durationMin / 60)}<span class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-left: 4px;">h</span>
                {dayForHike.data.driving.durationMin % 60 > 0 && (<>
                  <span style="margin-left: 8px;">{dayForHike.data.driving.durationMin % 60}</span><span class="mono-cap" style="font-size: 11px; color: var(--ink-soft); margin-left: 4px;">m</span>
                </>)}
              </div>
            </div>
            {dayForHike.data.driving.notes && <p style="font-size: 12.5px; color: var(--ink-soft); margin: 10px 0 0;">{dayForHike.data.driving.notes}</p>}
          </div>
        </section>
      )}

      {/* Where you sleep */}
      {dayLodging && (
        <section class="stagger" style="padding: 14px var(--page-x);">
          <h3 class="eyebrow" style="margin: 0 0 10px;">Where You Sleep</h3>
          <a href="/lodgings" style="
            display: block;
            background: var(--bg-paper);
            border: 1px solid var(--hairline);
            border-radius: var(--r-md);
            padding: 14px 16px;
            box-shadow: var(--shadow-paper-sm);
          ">
            <div style="display: flex; align-items: center; gap: 12px;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex: 0 0 auto;">
                <path d="M3 11 L12 4 L21 11 V21 H3 Z" stroke="var(--gold)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" />
                <path d="M9 21 V14 H15 V21" stroke="var(--ink-soft)" stroke-width="1.25" stroke-linejoin="round" />
              </svg>
              <div style="flex: 1; min-width: 0;">
                <div style="
                  font-family: var(--font-display);
                  font-weight: 600;
                  font-size: 18px;
                  line-height: 1.1;
                  color: var(--ink);
                ">{dayLodging.data.name}</div>
                <div class="mono" style="font-size: 11.5px; color: var(--ink-soft); margin-top: 2px; letter-spacing: 0.03em;">{dayLodging.data.location}</div>
              </div>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--ink-soft);">
                <path d="M9 6 L15 12 L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </a>
        </section>
      )}

      {/* Day's bad-weather option (if different from the hike's own) */}
      {dayForHike.data.badWeatherOption && dayForHike.data.badWeatherOption !== hike.data.badWeatherOption && (
        <section class="stagger" style="padding: 14px var(--page-x);">
          <h3 class="eyebrow signal" style="margin: 0 0 10px;">If The Day Goes Sideways</h3>
          <div style="background: var(--bg-paper); border: 1px solid var(--signal); border-left: 4px solid var(--signal); border-radius: var(--r-sm); padding: 12px 14px; font-size: 13.5px; color: var(--ink); transform: rotate(-0.5deg);">{dayForHike.data.badWeatherOption}</div>
        </section>
      )}

      {/* Also today — other hikes scheduled the same day */}
      {otherHikes.filter(Boolean).length > 0 && (
        <section class="stagger" style="padding: 14px var(--page-x) 28px;">
          <h3 class="eyebrow" style="margin: 0 0 12px;">Also Today</h3>
          <div style="display: grid; gap: 10px;">
            {otherHikes.filter(Boolean).map((h: any) => (
              <a href={`/hike/${h.slug}`} style="
                display: flex;
                align-items: center;
                gap: 12px;
                background: var(--bg-paper);
                border: 1px solid var(--hairline);
                border-radius: var(--r-md);
                padding: 12px 14px;
                box-shadow: var(--shadow-paper-sm);
              ">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex: 0 0 auto;">
                  <path d="M2 19 L8 9 L12 14 L15 10 L22 19" stroke="var(--gold)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" />
                </svg>
                <div style="flex: 1; min-width: 0;">
                  <div style="font-family: var(--font-display); font-weight: 600; font-size: 15.5px; line-height: 1.15; color: var(--ink);">{h.data.name}</div>
                  <div class="mono tabular" style="font-size: 11px; color: var(--ink-soft); margin-top: 3px; letter-spacing: 0.04em;">
                    {h.data.distanceKm} <span style="color: var(--ink-soft);">km</span> · {h.data.elevationGainM} <span style="color: var(--ink-soft);">m</span> · <span style="text-transform: capitalize;">{h.data.difficulty}</span>
                  </div>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--ink-soft);">
                  <path d="M9 6 L15 12 L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Day-page link footer */}
      <section style="padding: 8px var(--page-x) 28px; text-align: center;">
        <a
          href={`/day/${dayForHike.data.date}`}
          class="mono-cap"
          style="
            font-size: 10.5px;
            color: var(--ink-soft);
            padding: 8px 14px;
            border: 1px dashed var(--hairline);
            border-radius: var(--r-sm);
            display: inline-flex;
            align-items: center;
            gap: 6px;
          "
        >
          See Day {dayIndex + 1} On Its Own
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6 L15 12 L9 18" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </section>
    </>
  )}
</BaseLayout>
