---
/*
 * Day detail — vintage poster aesthetic.
 * Sticky date header in Fraunces; schedule with mono left rail; hike block
 * as a stat-block grid; driving as a "route slip"; lodging as a paper card.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditDayButton from '@/components/customize/EditDayButton';
import WeatherWidget from '@/components/WeatherWidget';
import DriveLegs from '@/components/DriveLegs.astro';
import { getDays, getHike, getLodgings, getActivities } from '@/lib/content';
import { haversineKm } from '@/lib/geo';

export async function getStaticPaths() {
  const days = await getDays();
  return days.map((d) => ({ params: { date: d.data.date }, props: { day: d } }));
}

const { day } = Astro.props;
const days = await getDays();
const dayIndex = days.findIndex((d) => d.data.date === day.data.date);
const prev = days[dayIndex - 1];
const next = days[dayIndex + 1];

const hikes = await Promise.all(day.data.hikeSlugs.map((slug: string) => getHike(slug)));
const lodgings = await getLodgings();
const lodging = lodgings.find((l) => l.id === day.data.lodgingSlug);

import MapRibbon from '@/components/MapRibbon.astro';
import type { Pin } from '@/lib/tile-math';
import { getTrip } from '@/lib/content';
import { phaseBoundary } from '@/lib/phase';
import { getWordmark } from '@/lib/wordmark';
const trip = getTrip();
const boundary = phaseBoundary(trip);
const isGardaFreeForm = day.data.hikeSlugs.length === 0 && day.data.date >= boundary;

// 4 nearest activities to Salò (anchor: lodging coords, NOT weatherFor) — same
// computation as the home page TodayBanner. Only relevant on free-form days.
const saloLodging = lodgings.find((l: any) => l.id === 'salo-airbnb');
const allActivities = isGardaFreeForm ? await getActivities() : [];
const nearestForToday = isGardaFreeForm && saloLodging
  ? [...allActivities]
      .filter((a: any) => typeof a.data.location?.lat === 'number')
      .sort((x: any, y: any) =>
        haversineKm(saloLodging.data.lat, saloLodging.data.lon, x.data.location.lat, x.data.location.lon) -
        haversineKm(saloLodging.data.lat, saloLodging.data.lon, y.data.location.lat, y.data.location.lon)
      )
      .slice(0, 4)
  : [];

const ribbonPins: Pin[] = [];
for (const h of hikes) {
  if (h?.data?.trailhead) {
    ribbonPins.push({
      lat: h.data.trailhead.lat,
      lon: h.data.trailhead.lon,
      label: `${h.data.name} (trailhead)`,
      href: `/hike/${h.slug}`,
      category: 'trailhead',
    });
  }
}
if (lodging) {
  ribbonPins.push({
    lat: lodging.data.lat,
    lon: lodging.data.lon,
    label: lodging.data.name,
    href: `/lodgings/${lodging.id}`,
    category: 'lodging',
  });
}
const ribbonCaption = `Day ${dayIndex + 1} · ${hikes.length} ${hikes.length === 1 ? 'hike' : 'hikes'} · lodging`;

const fmtFull = (iso: string) => new Date(iso + 'T00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
const fmtShort = (iso: string) => new Date(iso + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
---
<BaseLayout
  title={`Day ${dayIndex + 1} — ${day.data.theme}`}
  activeDayDate={day.data.date}
  headerTitle={getWordmark({ pathname: Astro.url.pathname, dayLodgingSlug: day.data.lodgingSlug })}
>
  <MapRibbon pins={ribbonPins} expandHref={`/map?day=${day.data.date}`} caption={ribbonCaption} />

  {/* Hero ─ Day stamp + date + theme */}
  <section class="stagger" style="padding: 24px var(--page-x) 14px;">
    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
      <span class="stamp">Day {String(dayIndex + 1).padStart(2, '0')} / {String(days.length).padStart(2, '0')}</span>
      <span class="mono-cap" style="font-size: 10.5px; color: var(--ink-soft);">{fmtFull(day.data.date)}</span>
    </div>
    <h1 style="
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 800;
      font-variation-settings: 'opsz' 144;
      font-size: clamp(36px, 9vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 14px 0 12px;
    ">{day.data.theme}</h1>
    <div style="margin-top: 4px;">
      <EditDayButton canonical={day.data} client:load />
    </div>
    <div style="display: flex; align-items: center; gap: 8px; margin-top: 18px;">
      <span style="flex: 1; height: 1px; background: var(--gold); opacity: 0.6;"></span>
      <span class="mono-cap" style="font-size: 11px; color: var(--ink-soft);">Itinerary</span>
      <span style="flex: 1; height: 1px; background: var(--gold); opacity: 0.6;"></span>
    </div>
  </section>

  {/* Weather */}
  <section class="stagger" style="padding: 8px var(--page-x);">
    <h2 class="eyebrow" style="margin: 0 0 10px;">Weather</h2>
    <WeatherWidget lat={day.data.weatherFor.lat} lon={day.data.weatherFor.lon} label={day.data.weatherFor.label} date={day.data.date} client:visible />
  </section>

  {/* Schedule — canonical timing for the day */}
  {day.data.schedule.length > 0 && (
    <section class="stagger" style="padding: 18px var(--page-x) 8px;">
      <h2 class="eyebrow" style="margin: 0 0 12px;">Schedule</h2>
      <ol style="
        list-style: none;
        margin: 0;
        padding: 0;
        background: var(--bg-paper);
        border: 1px solid var(--hairline);
        border-radius: var(--r-md);
        box-shadow: var(--shadow-paper-sm);
        overflow: hidden;
      ">
        {day.data.schedule.map((row: { time: string; action: string }, i: number) => (
          <li style={`
            display: grid;
            grid-template-columns: 64px 1fr;
            align-items: baseline;
            gap: 12px;
            padding: 10px 14px;
            ${i > 0 ? 'border-top: 1px dashed var(--hairline);' : ''}
          `}>
            <span class="mono tabular" style="
              font-size: 12px;
              color: var(--gold);
              letter-spacing: 0.04em;
              font-weight: 700;
            ">{row.time}</span>
            <span style="font-size: 13.5px; color: var(--ink); line-height: 1.45;">{row.action}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {/* Hikes — uniform .hike-poster cards (same shape as the home page) */}
  {hikes.length > 0 && (
    <section class="stagger" style="padding: 22px var(--page-x) 8px;">
      <h2 class="eyebrow" style="margin: 0 0 12px;">{hikes.length === 1 ? 'Hike' : 'Hikes'}</h2>
      <div style="display: grid; gap: 14px;">
        {hikes.filter(Boolean).map((h: any) => (
          <a href={`/hike/${h.slug}`} class="hike-poster">
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <span class="mono-cap" style="font-size: 11px; color: var(--ink-soft); letter-spacing: 0.18em; font-weight: 700;">Tap For Full Detail →</span>
              <span style="color: var(--gold); opacity: 0.6;">·</span>
              <span class="mono-cap" style="font-size: 9.5px; color: var(--ink-soft);">{h.data.region}</span>
            </div>
            <h3 style="
              font-family: var(--font-display);
              font-style: italic;
              font-weight: 800;
              font-variation-settings: 'opsz' 80;
              font-size: clamp(24px, 6.5vw, 30px);
              line-height: 1.02;
              letter-spacing: -0.018em;
              color: var(--ink);
              margin: 12px 0 10px;
              max-width: 96%;
            ">{h.data.name}</h3>
            <div class="poster-stats">
              <div style="text-align: center;">
                <div class="stat-num tabular">{h.data.distanceKm}</div>
                <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">km</div>
              </div>
              <div style="text-align: center; border-left: 1px dashed var(--hairline);">
                <div class="stat-num tabular">{h.data.elevationGainM}</div>
                <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">m gain</div>
              </div>
              <div style="text-align: center; border-left: 1px dashed var(--hairline);">
                <div class="stat-num tabular">{h.data.movingTimeHours.min}–{h.data.movingTimeHours.max}</div>
                <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">hours</div>
              </div>
              <div style="text-align: center; border-left: 1px dashed var(--hairline);">
                <div class="stat-num" style="text-transform: capitalize; font-size: 16px; padding-top: 4px;">{h.data.difficulty}</div>
                <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">grade</div>
              </div>
            </div>
            <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--hairline); display: flex; align-items: center; gap: 6px; color: var(--ink-soft);">
              <span class="mono-cap" style="font-size: 11px;">View Full Schedule</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12 H19 M14 6 L20 12 L14 18" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {isGardaFreeForm && (
    <section class="stagger" style="padding: 22px var(--page-x) 8px;">
      <h2 class="eyebrow" style="margin: 0 0 12px;">Today · Free at Salò</h2>
      {nearestForToday.length > 0 && (
        <div style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity;">
          {nearestForToday.map((a: any) => (
            <a href={`/activities/${a.id}`} style="
              flex: 0 0 auto;
              scroll-snap-align: start;
              padding: 10px 14px;
              background: var(--bg-paper);
              border: 1px solid var(--hairline);
              border-radius: var(--r-sm);
              text-decoration: none;
              min-width: 150px;
              max-width: 220px;
              box-shadow: var(--shadow-paper-sm);
            ">
              <div class="mono-cap" style="font-size: 9.5px; color: var(--ink-soft); letter-spacing: 0.18em;">{a.data.location.label}</div>
              <div style="font-family: var(--font-display); font-style: italic; font-weight: 700; font-size: 14.5px; color: var(--ink); margin-top: 4px; line-height: 1.2;">{a.data.name}</div>
            </a>
          ))}
        </div>
      )}
      <a href="/activities" style="
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding: 8px 0;
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-soft);
        text-decoration: none;
        border-bottom: 1px dashed var(--gold);
      ">Browse all {allActivities.length} activities
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12 H19 M14 6 L20 12 L14 18" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
      </a>
    </section>
  )}

  {/* Driving */}
  {day.data.driving.legs.length > 0 && (
    <section class="stagger" style="padding: 22px var(--page-x);">
      <h2 class="eyebrow" style="margin: 0 0 12px;">Driving</h2>
      <DriveLegs legs={day.data.driving.legs} />
    </section>
  )}

  {/* Lodging */}
  {lodging && (
    <section class="stagger" style="padding: 22px var(--page-x);">
      <h2 class="eyebrow" style="margin: 0 0 12px;">Lodging</h2>
      <a href={`/lodgings/${lodging.id}`} style="
        display: block;
        background: var(--bg-paper);
        border: 1px solid var(--hairline);
        border-radius: var(--r-md);
        padding: 14px 16px;
        box-shadow: var(--shadow-paper-sm);
      ">
        <div style="display: flex; align-items: center; gap: 12px;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex: 0 0 auto;">
            <path d="M3 11 L12 4 L21 11 V21 H3 Z" stroke="var(--gold)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" fill="none" />
            <path d="M9 21 V14 H15 V21" stroke="var(--ink-soft)" stroke-width="1.25" stroke-linejoin="round" />
          </svg>
          <div style="flex: 1;">
            <div style="
              font-family: var(--font-display);
              font-weight: 600;
              font-size: 18px;
              line-height: 1.1;
              color: var(--ink);
            ">{lodging.data.name}</div>
            <div class="mono" style="font-size: 11.5px; color: var(--ink-soft); margin-top: 2px; letter-spacing: 0.03em;">{lodging.data.location}</div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--ink-soft);">
            <path d="M9 6 L15 12 L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </a>
    </section>
  )}

  {/* Bad weather option */}
  {day.data.badWeatherOption && (
    <section class="stagger" style="padding: 22px var(--page-x);">
      <h2 class="eyebrow signal" style="margin: 0 0 12px;">If The Weather Turns</h2>
      <div style="
        background: var(--bg-paper);
        border: 1px solid var(--signal);
        border-left: 4px solid var(--signal);
        border-radius: var(--r-sm);
        padding: 12px 14px;
        font-size: 13.5px;
        color: var(--ink);
        transform: rotate(-0.5deg);
      ">{day.data.badWeatherOption}</div>
      <a href="/contingencies" class="mono-cap" style="
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 10px;
        font-size: 10.5px;
        color: var(--ink-soft);
      ">See all contingencies <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12 H19 M14 6 L20 12 L14 18" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </section>
  )}

  {/* Prev / next */}
  <nav style="
    padding: 28px var(--page-x);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px dashed var(--hairline);
    margin-top: 12px;
  ">
    {prev ? (
      <a href={`/day/${prev.data.date}`} style="display: flex; align-items: center; gap: 6px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6 L9 12 L15 18" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span class="mono-cap" style="font-size: 10.5px; color: var(--ink-soft);">{fmtShort(prev.data.date)}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={`/day/${next.data.date}`} style="display: flex; align-items: center; gap: 6px;">
        <span class="mono-cap" style="font-size: 10.5px; color: var(--ink-soft);">{fmtShort(next.data.date)}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6 L15 12 L9 18" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    ) : <span></span>}
  </nav>

  <style is:global>
    .hike-card:active { transform: scale(0.99); border-color: var(--gold) !important; }
  </style>
</BaseLayout>
