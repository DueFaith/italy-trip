---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActivities, getBookings } from '@/lib/content';

const activityCount = (await getActivities()).length;
const bookingCount = getBookings().length;

type Item = { href: string; label: string; hint: string };
type Group = { eyebrow: string; title: string; items: Item[] };

const groups: Group[] = [
  {
    eyebrow: 'Parte I',
    title: 'Dolomites',
    items: [
      { href: '/restaurants',   label: 'Restaurants',      hint: 'By area · Cortina, Brixen, Ortisei' },
      { href: '/contingencies', label: 'Contingencies',    hint: 'Weather rules · rainy-day backups' },
    ],
  },
  {
    eyebrow: 'Parte II',
    title: 'Lake Garda',
    items: [
      { href: '/activities',    label: 'Activities',       hint: `${activityCount} picks · jetski, Vittoriale, Solferino, Monte Baldo` },
    ],
  },
  {
    eyebrow: 'Trip-wide',
    title: 'Logistics',
    items: [
      { href: '/lodgings',      label: 'Lodgings',         hint: 'Hotels, addresses, contacts' },
      { href: '/checklist',     label: 'Booking Checklist',hint: `Pre-trip status · ${bookingCount} items` },
      { href: '/photos',        label: 'Photos',           hint: 'Empty for now · post-trip drop' },
      { href: '/customize',     label: 'Customize',        hint: 'Edit your local plan' },
    ],
  },
];
---
<BaseLayout title="More">
  <section class="stagger" style="padding: 24px var(--page-x) 8px;">
    <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">Index</span>
    <h1 style="
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 800;
      font-variation-settings: 'opsz' 144;
      font-size: clamp(36px, 9vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 8px 0 6px;
    ">More</h1>
  </section>

  {groups.map((g) => (
    <>
      <section class="stagger" style="padding: 18px var(--page-x) 4px;">
        <div style="display: flex; align-items: baseline; gap: 12px;">
          <span class="mono-cap" style="font-size: 11px; color: var(--gold); letter-spacing: 0.32em; font-weight: 700;">{g.eyebrow}</span>
          <span style="flex: 1; height: 1px; background: var(--gold); opacity: 0.55;"></span>
        </div>
        <h2 style="
          font-family: var(--font-display);
          font-style: italic;
          font-weight: 700;
          font-variation-settings: 'opsz' 80;
          font-size: 22px;
          letter-spacing: -0.01em;
          margin: 6px 0 0;
          color: var(--ink);
        ">{g.title}</h2>
      </section>

      <section class="stagger" style="padding: 8px var(--page-x) 4px; display: grid; gap: 10px;">
        {g.items.map((it) => (
          <a href={it.href} style="
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 16px;
            background: var(--bg-paper);
            border: 1px solid var(--hairline);
            border-radius: var(--r-md);
            box-shadow: var(--shadow-paper-sm);
            min-height: 64px;
          ">
            <div>
              <div style="font-family: var(--font-display); font-weight: 600; font-size: 18px; color: var(--ink); line-height: 1.1;">{it.label}</div>
              <div class="mono" style="font-size: 11.5px; color: var(--ink-soft); margin-top: 4px; letter-spacing: 0.02em;">{it.hint}</div>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--gold);">
              <path d="M9 6 L15 12 L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))}
      </section>
    </>
  ))}

  <div style="height: 32px;"></div>
</BaseLayout>
