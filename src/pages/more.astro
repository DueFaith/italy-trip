---
import BaseLayout from '@/layouts/BaseLayout.astro';
const items = [
  { href: '/lodgings', label: 'Lodgings' },
  { href: '/restaurants', label: 'Restaurants' },
  { href: '/checklist', label: 'Booking checklist' },
  { href: '/contingencies', label: 'Contingencies' },
  { href: '/photos', label: 'Photos' },
  { href: '/customize', label: 'Customize' },
];
---
<BaseLayout title="More">
  <section class="px-4 pt-5 pb-3 border-b border-border bg-bg-2/60">
    <h1 class="text-xl font-semibold">More</h1>
  </section>
  <section class="px-4 py-4 space-y-2">
    {items.map((it) => (
      <a href={it.href} class="card block text-sm font-semibold">{it.label}</a>
    ))}
  </section>
</BaseLayout>
