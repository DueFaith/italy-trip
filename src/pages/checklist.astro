---
/*
 * Booking checklist — vintage poster aesthetic.
 * The custom square checkboxes live inside <BookingChecklist /> (React island).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookingChecklist from '@/components/BookingChecklist';
import { getBookings } from '@/lib/content';
const bookings = getBookings();
---
<BaseLayout title="Booking checklist">
  <section class="stagger" style="padding: 24px var(--page-x) 14px;">
    <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">Pre-Trip</span>
    <h1 style="
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 800;
      font-variation-settings: 'opsz' 144;
      font-size: clamp(36px, 9vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 8px 0 10px;
    ">Booking Checklist</h1>
    <p class="mono" style="font-size: 12px; color: var(--ink-soft); letter-spacing: 0.02em;">Saved on this device only.</p>
    <div style="display: flex; align-items: center; gap: 8px; margin-top: 18px;">
      <span style="flex: 1; height: 1px; background: var(--gold); opacity: 0.6;"></span>
      <span class="mono-cap" style="font-size: 11px; color: var(--ink-soft);">Items</span>
      <span style="flex: 1; height: 1px; background: var(--gold); opacity: 0.6;"></span>
    </div>
  </section>

  <section class="stagger" style="padding: 6px var(--page-x) 28px;">
    <BookingChecklist bookings={bookings} client:load />
  </section>
</BaseLayout>
