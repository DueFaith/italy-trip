---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Photos">
  <section class="px-4 pt-5 pb-3 border-b border-border bg-bg-2/60">
    <h1 class="text-xl font-semibold">Photos</h1>
    <p class="text-[12px] text-ink-muted mt-1">Empty for now — populated post-trip.</p>
  </section>
  <section class="px-4 py-8 text-center text-ink-muted text-sm">
    <div class="w-24 h-24 mx-auto rounded-lg bg-gradient-to-br from-sage-2/30 to-forest/30 mb-4"></div>
    <p>Drop photos in <code class="bg-bg-2 px-1 rounded">public/photos/&lt;day&gt;/</code> after the trip.</p>
  </section>
</BaseLayout>
