---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActivities } from '@/lib/content';

export async function getStaticPaths() {
  const activities = await getActivities();
  return activities.map((a) => ({ params: { slug: a.id }, props: { activity: a } }));
}

const { activity } = Astro.props;
const a = activity.data;

import MapRibbon from '@/components/MapRibbon.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { CATEGORY_LABELS } from '@/lib/category-labels';
import type { Pin } from '@/lib/tile-math';

const ribbonPins: Pin[] = [{
  lat: a.location.lat,
  lon: a.location.lon,
  label: a.name,
  href: `/activities/${activity.id}`,
  category: 'activity',
}];

const gmapsUrl = `https://www.google.com/maps/search/?api=1&query=${a.location.lat},${a.location.lon}`;
const amapsUrl = `https://maps.apple.com/?ll=${a.location.lat},${a.location.lon}&q=${encodeURIComponent(a.name)}`;
---
<BaseLayout title={`${a.name} · Activities`} bodyClass="home-bg">
  <MapRibbon pins={ribbonPins} expandHref={`/map?focus=activity-${activity.id}`} caption={`${a.location.label} · ${a.name}`} />

  <Breadcrumb crumbs={[
    { label: 'Activities', href: '/activities' },
    { label: CATEGORY_LABELS[a.category] },
  ]} />

  {/* HERO ─────────────────────────────────────────────────────────── */}
  <section class="stagger" style="padding: 28px var(--page-x) 12px;">
    <p class="eyebrow with-rule" style="margin: 0;">{CATEGORY_LABELS[a.category]}</p>
    <h1 style="
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 800;
      font-variation-settings: 'opsz' 144;
      font-size: clamp(34px, 9vw, 54px);
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 10px 0 8px;
    ">{a.name}</h1>
    <p class="mono-cap" style="font-size: 12px; color: var(--ink-soft); margin: 0;">
      {a.location.label}
    </p>
  </section>

  {/* STAT BLOCK ───────────────────────────────────────────────────── */}
  <section class="stagger" style="padding: 14px var(--page-x) 8px;">
    <div class="poster-stats" style="
      background: var(--bg-paper);
      border: 1px solid var(--hairline);
      border-radius: var(--r-md);
      box-shadow: var(--shadow-paper-sm);
      padding: 16px 8px;
      grid-template-columns: repeat(4, 1fr);
    ">
      <div style="text-align: center;">
        <div class="stat-num" style="font-size: 14px; padding-top: 6px;">{a.cost.display}</div>
        <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">cost</div>
      </div>
      <div style="text-align: center; border-left: 1px dashed var(--hairline);">
        <div class="stat-num tabular">{a.durationHours ?? '—'}</div>
        <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">hours</div>
      </div>
      <div style="text-align: center; border-left: 1px dashed var(--hairline);">
        <div class="stat-num tabular" style="font-size: 14px; padding-top: 6px;">
          {a.driveFromSaloMin === undefined ? '—' : (a.driveFromSaloMin === 0 ? 'walk' : `${a.driveFromSaloMin}m`)}
        </div>
        <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">from Salò</div>
      </div>
      <div style="text-align: center; border-left: 1px dashed var(--hairline);">
        <div class="stat-num" style={`font-size: 14px; padding-top: 6px; color: ${a.bookingRequired ? 'var(--gold)' : 'var(--ink)'};`}>
          {a.bookingRequired ? 'Required' : 'Walk-in'}
        </div>
        <div class="mono-cap" style="font-size: 10px; color: var(--ink-soft); margin-top: 4px;">booking</div>
      </div>
    </div>
  </section>

  {/* DESCRIPTION ──────────────────────────────────────────────────── */}
  <section class="stagger" style="padding: 18px var(--page-x) 8px;">
    <p style="font-size: 16px; line-height: 1.55; color: var(--ink); margin: 0;">{a.description}</p>
  </section>

  {/* BOOKING CTA ──────────────────────────────────────────────────── */}
  {a.bookingRequired && (
    <section class="stagger" style="padding: 14px var(--page-x) 8px;">
      <div style="
        background: var(--bg-paper);
        border: 1px dashed var(--gold);
        border-radius: var(--r-md);
        padding: 14px 16px;
      ">
        <div class="mono-cap" style="font-size: 11px; color: var(--gold); margin-bottom: 6px;">
          Book in advance
        </div>
        {a.bookingNote && (
          <p style="margin: 0 0 10px; font-size: 13.5px; color: var(--ink); line-height: 1.5;">{a.bookingNote}</p>
        )}
        {a.url && (
          <a href={a.url} target="_blank" rel="noopener" style="
            display: inline-block;
            padding: 10px 16px;
            background: var(--ink);
            color: var(--bg);
            border-radius: var(--r-sm);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            min-height: 44px;
            line-height: 24px;
          ">Open booking site →</a>
        )}
      </div>
    </section>
  )}

  {/* MAP LINKS ────────────────────────────────────────────────────── */}
  <section class="stagger" style="padding: 14px var(--page-x) 8px; display: flex; gap: 8px; flex-wrap: wrap;">
    <a href={amapsUrl} target="_blank" rel="noopener" style="
      flex: 1; min-width: 140px;
      padding: 12px 14px;
      border: 1px solid var(--hairline);
      border-radius: var(--r-sm);
      text-align: center;
      font-size: 13px;
      color: var(--ink);
      text-decoration: none;
      min-height: 44px;
    ">Open in Apple Maps</a>
    <a href={gmapsUrl} target="_blank" rel="noopener" style="
      flex: 1; min-width: 140px;
      padding: 12px 14px;
      border: 1px solid var(--hairline);
      border-radius: var(--r-sm);
      text-align: center;
      font-size: 13px;
      color: var(--ink);
      text-decoration: none;
      min-height: 44px;
    ">Open in Google Maps</a>
  </section>

  {/* BACK LINK ────────────────────────────────────────────────────── */}
  <section class="stagger" style="padding: 24px var(--page-x) 32px;">
    <a href="/activities" class="mono-cap" style="font-size: 11px; color: var(--ink-soft);">
      ← Back to catalog
    </a>
  </section>
</BaseLayout>
