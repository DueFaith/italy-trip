---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CustomizePanel from '@/components/customize/CustomizePanel';
import ShareLinkButton from '@/components/ShareLinkButton';
import { getDays, getHikes } from '@/lib/content';

const days = await getDays();
const hikes = await getHikes();

const canonicalDays = days.map((d) => d.data);
const canonicalHikes = hikes.map((h) => ({ ...h.data, slug: h.slug }));
---
<BaseLayout title="Customize">
  <section class="px-4 pt-5 pb-3 border-b border-border bg-bg-2/60">
    <h1 class="text-xl font-semibold">Customize</h1>
    <p class="text-[12px] text-ink-muted mt-1">Edits stay on this device. Use share-link to send to others.</p>
  </section>
  <section class="px-4 py-4">
    <CustomizePanel canonicalDays={canonicalDays} canonicalHikes={canonicalHikes} client:load />
    <div class="mt-6">
      <ShareLinkButton client:load />
    </div>
  </section>
</BaseLayout>
