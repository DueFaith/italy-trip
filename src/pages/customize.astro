---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CustomizePanel from '@/components/customize/CustomizePanel';
import ShareLinkButton from '@/components/ShareLinkButton';
import { getDays, getHikes } from '@/lib/content';

const days = await getDays();
const hikes = await getHikes();

const canonicalDays = days.map((d) => d.data);
const canonicalHikes = hikes.map((h) => ({ ...h.data, slug: h.slug }));
---
<BaseLayout title="Customize">
  <section class="stagger" style="padding: 24px var(--page-x) 12px;">
    <span class="mono-cap" style="font-size: 10px; color: var(--ink-soft);">Your Local Plan</span>
    <h1 style="
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 800;
      font-variation-settings: 'opsz' 144;
      font-size: clamp(36px, 9vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 8px 0 8px;
    ">Customize</h1>
    <p style="font-size: 12.5px; color: var(--ink-soft); line-height: 1.5;">
      Edits stay on this device. Use the <strong style="color: var(--ink-soft); font-weight: 700;">share link</strong> to send your version to companions.
    </p>
  </section>

  <section class="stagger" style="padding: 6px var(--page-x) 12px;">
    <CustomizePanel canonicalDays={canonicalDays} canonicalHikes={canonicalHikes} client:load />
  </section>

  {/* Sticky share bar — always visible while you're on /customize */}
  <div
    style="
      position: sticky;
      bottom: calc(64px + env(safe-area-inset-bottom));
      z-index: 15;
      padding: 12px var(--page-x);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(12px) saturate(140%);
      -webkit-backdrop-filter: blur(12px) saturate(140%);
      border-top: 1px solid var(--hairline);
      margin-top: 32px;
    "
  >
    <ShareLinkButton client:load />
  </div>
</BaseLayout>
