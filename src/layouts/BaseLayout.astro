---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import BottomNav from '@/components/BottomNav.astro';
import DayPillScroller from '@/components/DayPillScroller.astro';
import ReceiveShareLink from '@/components/ReceiveShareLink';
import RegisterServiceWorker from '@/components/RegisterServiceWorker.astro';
const { title = 'Dolomites + Garda', headerTitle, bodyClass, activeDayDate } = Astro.props as {
  title?: string;
  headerTitle?: string;
  bodyClass?: string;
  activeDayDate?: string;
};

// Wordmark in the top-left header. Pages can override via `headerTitle` prop;
// otherwise we pick a sensible default from the URL path. The trip spans two
// regions (Dolomites + Lake Garda), so showing "DOLOMITES" everywhere was
// misleading once Phase II content shipped.
function wordmarkForPath(rawPath: string): string {
  // Astro can emit static pages with a trailing slash (e.g. "/map/" instead
  // of "/map"); normalise so equality checks below catch both forms.
  const p = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');
  if (p === '/') return 'Dolomites + Garda';
  if (p === '/activities' || p.startsWith('/activities/')) return 'Lago di Garda';
  if (p === '/map') return 'Map';
  if (p === '/checklist') return 'Checklist';
  if (p === '/customize') return 'Customize';
  if (p === '/photos') return 'Photos';
  if (p === '/more') return 'More';
  if (p === '/restaurants') return 'Restaurants';
  if (p === '/contingencies') return 'Contingencies';
  if (p === '/hikes') return 'Hikes';
  if (p === '/lodgings') return 'Lodgings';
  // /hike/*, /day/*, /lodgings/* — these have geographic context only the
  // page itself knows (which lodging, which region). Those pages pass
  // headerTitle explicitly. Fall back to the trip name.
  return 'Dolomites + Garda';
}
const resolvedHeaderTitle = headerTitle ?? wordmarkForPath(Astro.url.pathname);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F1E9D2" />
    <meta name="theme-color" content="#14282B" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500..900;1,9..144,500..900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header title={resolvedHeaderTitle} />
    {activeDayDate && <DayPillScroller activeDate={activeDayDate} />}
    <main id="main" tabindex="-1" class="mx-auto" style="max-width: var(--max-content); outline: none;"><slot /></main>
    <BottomNav />
    <ReceiveShareLink client:load />
    <RegisterServiceWorker />
    <script is:inline>
      // After View Transitions swap a new page in, move keyboard focus to
      // <main> so screen readers announce the new content. tabindex=-1 lets
      // .focus() succeed without inserting <main> into the tab order.
      document.addEventListener('astro:after-swap', () => {
        document.getElementById('main')?.focus();
      });
    </script>
  </body>
</html>
